@model List<BikeStore.Web.Models.Bicicleta>

@{
    ViewData["Title"] = "Bicicletas";
    var marcaFiltro = ViewBag.MarcaFiltro as string;
    var categoriaFiltro = ViewBag.CategoriaFiltro as string;
}

<style>
    body {
        background-color: #eef2f7;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Catálogo de bicicletas</h1>
        <p class="text-muted mb-0">Gestiona el inventario de BikeStore</p>
    </div>
    <a asp-action="Crear" class="btn btn-primary">+ Nueva bicicleta</a>
</div>

<!-- Formulario de Búsqueda Mejorado con Select -->
<form method="get" asp-action="Index" class="bg-white shadow-sm rounded p-3 mb-4 d-flex gap-2 align-items-end">
    <div class="flex-grow-1">
        <label class="form-label mb-1">Buscar por marca</label>
        <input type="text" name="marca" value="@marcaFiltro" class="form-control" placeholder="Ej: Trek, Giant..." />
    </div>
    <div class="flex-grow-1">
        <label class="form-label mb-1">Categoría</label>
        <!-- Cambiamos el input de texto por un select que usa el ViewBag.ListaCategorias -->
        <select name="categoria" class="form-control" asp-items="ViewBag.ListaCategorias">
            <option value="">-- Todas las categorías --</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Buscar</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">No se encontraron bicicletas con esos filtros.</div>
}
else
{
    <table class="table table-hover align-middle bg-white shadow-sm rounded overflow-hidden mb-0">
        <thead class="table-dark">
            <tr>
                <th>Marca</th>
                <th>Modelo</th>
                <th class="text-end">Precio</th>
                <th class="text-center">Stock</th>
                <th class="text-center">Estado</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var bici in Model)
            {
                string badgeClass = bici.Estado switch
                {
                    "Disponible" => "bg-success",
                    "Stock Bajo" => "bg-warning text-dark",
                    "Agotado" => "bg-danger",
                    _ => "bg-secondary"
                };

                <tr>
                    <td>@bici.Marca</td>
                    <td>@bici.Modelo</td>
                    <td class="text-end">$@bici.Precio.ToString("N2")</td>
                    <td class="text-center">@bici.Stock</td>
                    <td class="text-center">
                        <span class="badge @badgeClass">@bici.Estado</span>
                    </td>
                    <td class="text-center">
                        <a asp-action="Editar" asp-route-id="@bici.IdBicicleta" class="btn btn-sm btn-outline-secondary">Editar</a>
                        <a asp-action="Eliminar" asp-route-id="@bici.IdBicicleta" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}