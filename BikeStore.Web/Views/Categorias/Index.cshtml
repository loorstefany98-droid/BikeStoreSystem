@model List<BikeStore.Web.Models.Categoria>

@{
    ViewData["Title"] = "Categorías";
}

<style>
    body {
        background-color: #f3eefa;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1" style="color: #6b3fa0;">Categorías</h1>
        <p class="text-muted mb-0">Administra las categorías de BikeStore</p>
    </div>
    <a asp-action="Crear" class="btn" style="background-color: #8a5cc9; color: white;">+ Nueva categoría</a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info mb-0">No hay categorías registradas todavía.</div>
}
else
{
    <table class="table table-hover align-middle bg-white shadow-sm rounded overflow-hidden mb-0">
        <thead style="background-color: #6b3fa0;">
            <tr style="color: white;">
                <th>Nombre</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var categoria in Model)
            {
                <tr>
                    <td>@categoria.Nombre</td>
                    <td class="text-center">
                        <a asp-action="Editar" asp-route-id="@categoria.IdCategoria" class="btn btn-sm btn-outline-secondary">Editar</a>
                        <form asp-action="Eliminar" asp-route-id="@categoria.IdCategoria" method="post" style="display:inline;"
                              onsubmit="return confirm('¿Eliminar la categoría @categoria.Nombre?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}