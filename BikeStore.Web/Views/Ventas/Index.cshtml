@model List<BikeStore.Web.Models.Venta>
@{
    ViewData["Title"] = "Historial de ventas";
}

<style>
    body {
        background-color: #fbeee7;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1" style="color: #d85a30;">Historial de ventas</h1>
        <p class="text-muted mb-0">Todas las ventas registradas en BikeStore</p>
    </div>
    <a asp-action="Crear" class="btn" style="background-color:#d85a30; color:white;">+ Nueva venta</a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info mb-0">No hay ventas registradas todavía.</div>
}
else
{
    <table class="table table-hover align-middle bg-white shadow-sm rounded overflow-hidden mb-0">
        <thead style="background-color: #854f0b;">
            <tr style="color: white;">
                <th>N° Venta</th>
                <th>Fecha</th>
                <th>Cliente</th>
                <th class="text-end">Total</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var venta in Model)
            {
                <tr>
                    <td>#@venta.IdVenta</td>
                    <td>@venta.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@(venta.Cliente != null ? $"{venta.Cliente.Nombres} {venta.Cliente.Apellidos}" : "Cliente #" + venta.IdCliente)</td>
                    <td class="text-end">$@venta.Total.ToString("N2")</td>
                    <td class="text-center">
                        <a asp-action="Detalles" asp-route-id="@venta.IdVenta" class="btn btn-sm" style="background-color:#d85a30; color:white;">Ver detalles</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}