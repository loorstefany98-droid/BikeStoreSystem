@model BikeStore.Web.Models.Venta
@{
    ViewData["Title"] = "Detalle de venta";
}

<style>
    body {
        background-color: #fbeee7;
    }
</style>

<div class="bg-white shadow-sm rounded p-4">
    <h1 class="mb-1" style="color: #d85a30;">Detalle de venta #@Model.IdVenta</h1>
    <p class="text-muted mb-4">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</p>

    <p>
        <strong>Cliente:</strong>
        @(Model.Cliente != null ? $"{Model.Cliente.Nombres} {Model.Cliente.Apellidos} ({Model.Cliente.Cedula})" : "Cliente #" + Model.IdCliente)
    </p>

    <hr />
    <h5>Bicicletas compradas</h5>

    @if (!Model.Detalles.Any())
    {
        <div class="alert alert-info">No se encontró el detalle de esta venta.</div>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Bicicleta</th>
                    <th class="text-center">Cantidad</th>
                    <th class="text-end">Precio unitario</th>
                    <th class="text-end">Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var detalle in Model.Detalles)
                {
                    <tr>
                        <td>
                            @(detalle.Bicicleta != null ? $"{detalle.Bicicleta.Marca} {detalle.Bicicleta.Modelo}" : "Bicicleta #" + detalle.IdBicicleta)
                        </td>
                        <td class="text-center">@detalle.Cantidad</td>
                        <td class="text-end">$@detalle.Precio.ToString("N2")</td>
                        <td class="text-end">$@detalle.SubTotal.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="d-flex justify-content-end">
        <div class="fw-bold" style="color:#d85a30; font-size: 1.2em;">
            Total: $@Model.Total.ToString("N2")
        </div>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary mt-3">← Volver al historial</a>
</div>
